{
  "permissions": {
    "allow": [
      "Bash(python3 tools/feedback.py:*)",
      "Bash(python3 tools/benchmark.py:*)",
      "Bash(python3 tools/startup_db.py:*)",
      "Bash(python3 tools/instagram_api.py:*)",
      "Bash(python3 tools/meta_ads.py validate:*)",
      "Bash(python3 tools/meta_ads.py insights:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ads_guard.py\""
          }
        ]
      }
    ]
  }
}
