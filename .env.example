# Copy to .env (never commit it) or set these as environment secrets in your
# Claude Code cloud environment settings.

# Module 3 - Instagram Graph API + Meta Marketing API
META_ACCESS_TOKEN=          # system-user token: instagram_basic, instagram_manage_insights, pages_read_engagement, ads_management, ads_read
META_AD_ACCOUNT_ID=         # digits only, without act_
META_PAGE_ID=
IG_USER_ID=                 # Instagram Business/Creator account id linked to the Page

# Module 2 - optional paid startup databases
CRUNCHBASE_API_KEY=
DEALROOM_API_KEY=
